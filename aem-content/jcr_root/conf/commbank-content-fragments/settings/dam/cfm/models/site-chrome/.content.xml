<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/commbank/home-loans(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/commbank-content-fragments/settings/dam/cfm/models/site-chrome/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="Global site chrome (header nav, section-navigation row, footer) — one singleton instance shared across every Home Loans page, fetched once by the shared Next.js layout instead of duplicated per page."
        jcr:primaryType="cq:PageContent"
        jcr:title="Site Chrome"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured">
            <graphQL
                jcr:primaryType="nt:unstructured"
                apiName="SiteChrome"
                queryFieldMultiple="siteChromeList"
                queryFieldSingle="siteChromeByPath"/>
        </metadata>
        <model
            cq:targetPath="/content/dam/commbank/home-loans"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="10">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items jcr:primaryType="nt:unstructured">
                        <navLinks
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference/multifield"
                            allowNew="{Boolean}true"
                            fieldLabel="Header Nav Links"
                            filter="hierarchy"
                            fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/nav-link"
                            listOrder="1"
                            metaType="fragment-reference"
                            name="navLinks"
                            nameSuffix="contentReference"
                            rootPath="/content/dam/commbank/home-loans"
                            valueType="string/content-fragment[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                                fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/nav-link"
                                name="navLinks">
                                <granite:data jcr:primaryType="nt:unstructured"/>
                            </field>
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </navLinks>
                        <sectionNavItems
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference/multifield"
                            allowNew="{Boolean}true"
                            fieldLabel="Section Nav Items"
                            filter="hierarchy"
                            fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/section-nav-item"
                            listOrder="2"
                            metaType="fragment-reference"
                            name="sectionNavItems"
                            nameSuffix="contentReference"
                            rootPath="/content/dam/commbank/home-loans"
                            valueType="string/content-fragment[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                                fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/section-nav-item"
                                name="sectionNavItems">
                                <granite:data jcr:primaryType="nt:unstructured"/>
                            </field>
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </sectionNavItems>
                        <footerColumns
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference/multifield"
                            allowNew="{Boolean}true"
                            fieldLabel="Footer Columns"
                            filter="hierarchy"
                            fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/footer-column"
                            listOrder="3"
                            metaType="fragment-reference"
                            name="footerColumns"
                            nameSuffix="contentReference"
                            rootPath="/content/dam/commbank/home-loans"
                            valueType="string/content-fragment[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                                fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/footer-column"
                                name="footerColumns">
                                <granite:data jcr:primaryType="nt:unstructured"/>
                            </field>
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </footerColumns>
                        <footerText
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                            cfm-element="Text"
                            default-mime-type="text/html"
                            fieldDescription="Plain text — the 'Traditional Owners' link is rendered around acknowledgementLinkText by Next.js using acknowledgementLinkUrl below, since embedded HTML doesn't round-trip through this field type."
                            fieldLabel="Footer Acknowledgement Text"
                            listOrder="4"
                            metaType="text-multi"
                            name="footerText"
                            valueType="string"/>
                        <acknowledgementLinkText
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Acknowledgement Link Text"
                            listOrder="5"
                            metaType="text-single"
                            name="acknowledgementLinkText"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </acknowledgementLinkText>
                        <acknowledgementLinkUrl
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Acknowledgement Link URL"
                            listOrder="6"
                            metaType="text-single"
                            name="acknowledgementLinkUrl"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </acknowledgementLinkUrl>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
