<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/commbank/home-loans(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/commbank-content-fragments/settings/dam/cfm/models/footer-column/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="One titled column of links in the site footer (e.g. Quick links, About us, Important information)."
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer Column"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured">
            <graphQL
                jcr:primaryType="nt:unstructured"
                apiName="FooterColumnModel"
                queryFieldMultiple="footerColumnModelList"
                queryFieldSingle="footerColumnModelByPath"/>
        </metadata>
        <model
            cq:targetPath="/content/dam/commbank/home-loans"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="10">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items jcr:primaryType="nt:unstructured">
                        <sectionTitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Section Title"
                            listOrder="1"
                            metaType="text-single"
                            name="sectionTitle"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </sectionTitle>
                        <links
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference/multifield"
                            allowNew="{Boolean}true"
                            fieldLabel="Links"
                            filter="hierarchy"
                            fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/nav-link"
                            listOrder="2"
                            metaType="fragment-reference"
                            name="links"
                            nameSuffix="contentReference"
                            rootPath="/content/dam/commbank/home-loans"
                            valueType="string/content-fragment[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                                fragmentmodelreference="/conf/commbank-content-fragments/settings/dam/cfm/models/nav-link"
                                name="links">
                                <granite:data jcr:primaryType="nt:unstructured"/>
                            </field>
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </links>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
