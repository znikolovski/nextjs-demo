<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/commbank/pages(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/commbank-content-fragments/settings/dam/cfm/models/page/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="Generic page abstraction: a routable page identified by its path, composed of an ordered list of section fragments. The Next.js frontend resolves a dynamic route by looking up a Page whose path matches the request, then renders its sections in list order."
        jcr:primaryType="cq:PageContent"
        jcr:title="Page"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured">
            <graphQL
                jcr:primaryType="nt:unstructured"
                apiName="Page"
                queryFieldMultiple="pageList"
                queryFieldSingle="pageByPath"/>
        </metadata>
        <model
            cq:targetPath="/content/dam/commbank/pages"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="10">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items jcr:primaryType="nt:unstructured">
                        <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Title"
                            listOrder="1"
                            metaType="text-single"
                            name="title"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </title>
                        <path
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            constraintMessage="Path must start with &quot;pages/&quot; (no leading or trailing slash) so it never collides with a dedicated Next.js route, e.g. pages/refinance-guide."
                            fieldDescription="The routable URL path this page is served at, e.g. pages/refinance-guide. Must start with &quot;pages/&quot;."
                            fieldLabel="Path"
                            listOrder="2"
                            metaType="text-single"
                            name="path"
                            pattern="^pages/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </path>
                        <seoTitle
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="SEO Title"
                            listOrder="3"
                            metaType="text-single"
                            name="seoTitle"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </seoTitle>
                        <seoDescription
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                            cfm-element="Text"
                            default-mime-type="text/html"
                            fieldLabel="SEO Description"
                            listOrder="4"
                            metaType="text-multi"
                            name="seoDescription"
                            valueType="string"/>
                        <sections
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference/multifield"
                            allowNew="{Boolean}true"
                            fieldDescription="The page's sections, in display order. Reorder rows here to restructure the page &#8212; no code change or redeploy needed."
                            fieldLabel="Sections"
                            filter="hierarchy"
                            fragmentmodelreference="[/conf/commbank-content-fragments/settings/dam/cfm/models/hero-banner,/conf/commbank-content-fragments/settings/dam/cfm/models/feature-item,/conf/commbank-content-fragments/settings/dam/cfm/models/product-card,/conf/commbank-content-fragments/settings/dam/cfm/models/section-group]"
                            listOrder="5"
                            metaType="fragment-reference"
                            name="sections"
                            nameSuffix="contentReference"
                            rootPath="/content/dam/commbank"
                            valueType="string/content-fragment[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                                fragmentmodelreference="[/conf/commbank-content-fragments/settings/dam/cfm/models/hero-banner,/conf/commbank-content-fragments/settings/dam/cfm/models/feature-item,/conf/commbank-content-fragments/settings/dam/cfm/models/product-card,/conf/commbank-content-fragments/settings/dam/cfm/models/section-group]"
                                name="sections">
                                <granite:data jcr:primaryType="nt:unstructured"/>
                            </field>
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </sections>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
